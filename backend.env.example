# Copy to /etc/outsourcing-deploy/backend.env on EC2 (chmod 600). Keep real secrets only on the server.
# Every value is optional: a missing feature degrades gracefully (chat -> form, no e-mail, payment "준비 중").

# 회사명 (상담봇이 소개할 이름, frontend/src/app/site-config.ts 와 맞춤)
COMPANY_NAME=핏에이전트

# AI 상담봇 (Claude API)
ANTHROPIC_API_KEY=
CONSULT_MODEL=claude-sonnet-5-5
# 하루 최대 상담 응답 수 (비용 상한)
CONSULT_DAILY_LIMIT=500

# 상담 접수·결제 완료 알림 메일 (Gmail은 앱 비밀번호, 587 STARTTLS 또는 465 SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
# 알림 메일의 관리 화면 링크에 쓰는 주소
PUBLIC_BASE_URL=http://16.176.219.121

# 관리 화면(/admin) 비밀번호, 8자 이상. 비워 두면 관리 화면이 잠김
ADMIN_PASSWORD=

# 토스페이먼츠 API 개별 연동 키 (테스트: test_ck_ / test_sk_, 실결제: live_)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 로컬 테스트 전용: 토스 키 없이 결제 완료 흐름만 확인 (운영 서버에는 넣지 않음)
# PAYMENT_MOCK=1
